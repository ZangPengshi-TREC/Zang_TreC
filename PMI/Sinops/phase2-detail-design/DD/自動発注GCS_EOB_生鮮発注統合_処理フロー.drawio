        <mxCell id="h" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontFamily=Arial;fontColor=#1F4E79;" value="生鮮　実装手順　自動発注GCS → dborder" vertex="1">
          <mxGeometry height="30" width="760" x="24" y="12" as="geometry" />
        </mxCell>
        <mxCell id="hs" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontFamily=Arial;fontColor=#333333;" value="上から下へ実装する。STEP 番号はシート 02_GCS→dborder。Ordertype は使わない。Layer②は対象外。" vertex="1">
          <mxGeometry height="20" width="900" x="24" y="42" as="geometry" />
        </mxCell>
        <mxCell id="in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;入力&lt;/b&gt;　gs://autoorder-prod/lv3-trc-jiha-prod/SINOPS/&lt;br&gt;LAST　SIREJAN_RCMDORDER_LAST_YYYYMMDD.gz　＋　空の END&lt;br&gt;LAST_SUB　SIREJAN_RCMDORDER_LAST_SUB_YYYYMMDD.gz&lt;br&gt;中身は Layer① のまま。変換は行ごと。中断条件に当たったらファイルを止める。&lt;br&gt;&lt;br&gt;&lt;b&gt;当日ジョブ&lt;/b&gt;　採用した当日分と LAST_SUB。同じ表。&lt;br&gt;&lt;b&gt;翌日ジョブ&lt;/b&gt;　LAST_SUB。1週間分は先行して更新。当日ファイルが無いときは、昨日の翌日以降のうち発注日が当日の行。" vertex="1">
          <mxGeometry height="130" width="560" x="40" y="72" as="geometry" />
        </mxCell>
        <mxCell id="st" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=13;fontStyle=1;" value="開始" vertex="1">
          <mxGeometry height="36" width="140" x="250" y="220" as="geometry" />
        </mxCell>
        <mxCell id="d10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" value="STEP10&lt;br&gt;LAST の END が&lt;br&gt;あるか" vertex="1">
          <mxGeometry height="90" width="220" x="210" y="276" as="geometry" />
        </mxCell>
        <mxCell id="x10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Arial;fontSize=12;fontColor=#9b2c2c;" value="中断&lt;br&gt;END が無い" vertex="1">
          <mxGeometry height="50" width="300" x="640" y="296" as="geometry" />
        </mxCell>
        <mxCell id="p20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP20　ファイル取得&lt;/b&gt;&lt;br&gt;LAST と LAST_SUB を読む。中身はまだ変換しない。" vertex="1">
          <mxGeometry height="52" width="400" x="120" y="386" as="geometry" />
        </mxCell>
        <mxCell id="d20" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" value="取得&lt;br&gt;できたか" vertex="1">
          <mxGeometry height="80" width="200" x="220" y="454" as="geometry" />
        </mxCell>
        <mxCell id="x20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Arial;fontSize=12;fontColor=#9b2c2c;" value="中断&lt;br&gt;取得失敗" vertex="1">
          <mxGeometry height="50" width="300" x="640" y="469" as="geometry" />
        </mxCell>
        <mxCell id="p30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP30　統合マスタ&lt;/b&gt;&lt;br&gt;店CD → int　ベンダーCD → int&lt;br&gt;JAN はそのまま。切捨てなし。ゼロ埋めなし。" vertex="1">
          <mxGeometry height="64" width="400" x="120" y="554" as="geometry" />
        </mxCell>
        <mxCell id="d30" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" value="一致し、&lt;br&gt;店と仕入先は&lt;br&gt;数値か" vertex="1">
          <mxGeometry height="90" width="220" x="210" y="636" as="geometry" />
        </mxCell>
        <mxCell id="x30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Arial;fontSize=12;fontColor=#9b2c2c;" value="中断&lt;br&gt;不一致、または非数値" vertex="1">
          <mxGeometry height="50" width="300" x="640" y="656" as="geometry" />
        </mxCell>
        <mxCell id="p40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP40　納品日&lt;/b&gt;&lt;br&gt;yyyymmdd → datetime。年月日のみ。時刻は入れない。" vertex="1">
          <mxGeometry height="52" width="400" x="120" y="746" as="geometry" />
        </mxCell>
        <mxCell id="d40" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" value="日付として&lt;br&gt;正しいか" vertex="1">
          <mxGeometry height="80" width="200" x="220" y="814" as="geometry" />
        </mxCell>
        <mxCell id="x40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Arial;fontSize=12;fontColor=#9b2c2c;" value="中断&lt;br&gt;日付不正" vertex="1">
          <mxGeometry height="50" width="300" x="640" y="829" as="geometry" />
        </mxCell>
        <mxCell id="p50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b&gt;STEP50　固定値をセット&lt;/b&gt;&lt;br&gt;便 Bin = 1　（表の既定 便なし=9999 は使わない）&lt;br&gt;発注種類CD OrderKindCD = 1　普通発注&lt;br&gt;登録FLG EntryFLG = 0　客注数 CustOrderQty = NULL&lt;br&gt;登録日 CreateTime = getdate()　時分秒あり&lt;br&gt;更新日 UpdateTime = 空白&lt;br&gt;Ordertype はセットしない" vertex="1">
          <mxGeometry height="128" width="400" x="120" y="914" as="geometry" />
        </mxCell>
        <mxCell id="p60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP60　数量&lt;/b&gt;&lt;br&gt;発注バラ数 → 推奨数 RecQuantity と 発注数 OrderQty&lt;br&gt;×1000 しない。発注数は NULL 可。" vertex="1">
          <mxGeometry height="64" width="400" x="120" y="1062" as="geometry" />
        </mxCell>
        <mxCell id="p70" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP70　担当CD UserCD&lt;/b&gt;&lt;br&gt;空で書かない。採番し直すか 90000112（自動発注）。&lt;br&gt;どちらかは未確認。確定するまで値を仮置きしない。" vertex="1">
          <mxGeometry height="64" width="400" x="120" y="1146" as="geometry" />
        </mxCell>
        <mxCell id="p80" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP80　キー&lt;/b&gt;&lt;br&gt;ProdJAN、BranchCD、SupplierCD、DeliveryDate、Bin&lt;br&gt;5列が同じ行があれば UPDATE。無ければ INSERT。" vertex="1">
          <mxGeometry height="64" width="400" x="120" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="p90" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=12;" value="&lt;b&gt;STEP90　書込（DBOUT）&lt;/b&gt;&lt;br&gt;192.168.1.129（生鮮発注統合SV）&lt;br&gt;dborder / shT_OrderQty_test&lt;br&gt;EOB には入れない&lt;br&gt;分類・単価・単位・発注日は列がないので送らない" vertex="1">
          <mxGeometry height="130" width="340" x="150" y="1314" as="geometry" />
        </mxCell>
        <mxCell id="d90" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" value="書けた&lt;br&gt;か" vertex="1">
