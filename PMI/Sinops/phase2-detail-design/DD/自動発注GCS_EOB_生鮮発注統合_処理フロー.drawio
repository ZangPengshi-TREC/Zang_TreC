        <mxCell id="h" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontFamily=Arial;fontColor=#1F4E79;" value="非生鮮　実装手順　自動発注GCS → EOB" vertex="1">
          <mxGeometry height="30" width="760" x="24" y="12" as="geometry" />
        </mxCell>
        <mxCell id="hs" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontFamily=Arial;fontColor=#333333;" value="上から下へ実装する。STEP 番号はシート 02_Layer⓪設計。採用判定はやり直さない。Layer②は対象外。" vertex="1">
          <mxGeometry height="20" width="920" x="24" y="42" as="geometry" />
        </mxCell>
        <mxCell id="in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;入力&lt;/b&gt;　gs://autoorder-prod/lv3-trc-jiha-prod/SINOPS/&lt;br&gt;採用した 1 本　SIREJAN_RCMDORDER_LAST_YYYYMMDD.gz　＋　空の END&lt;br&gt;LAST_SUB　SIREJAN_RCMDORDER_LAST_SUB_YYYYMMDD.gz&lt;br&gt;同じ加工を 2 本にかける。加工のあと、採用 1 本は EOB、LAST_SUB は EOB_SUB（仮）。" vertex="1">
          <mxGeometry height="88" width="560" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="st" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=13;fontStyle=1;" value="開始" vertex="1">
