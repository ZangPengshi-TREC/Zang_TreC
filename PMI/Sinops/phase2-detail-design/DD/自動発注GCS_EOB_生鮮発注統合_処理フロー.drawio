        </mxCell>
        <mxCell id="p20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP20〜40　統合マスタ&lt;/b&gt;&lt;br&gt;店CD、商品CD（仕入発注JAN）、仕入先CD&lt;br&gt;切捨てなし。3項目ともマスタ後の値にする。" vertex="1">
          <mxGeometry height="64" width="400" x="120" y="340" as="geometry" />
        </mxCell>
        <mxCell id="d20" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=12;" value="3項目とも&lt;br&gt;一致したか" vertex="1">
