  <diagram id="hiseisen-dev" name="非生鮮_実装手順">
    <mxGraphModel dx="1125" dy="807" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1960" math="0" shadow="0">
      <root>
