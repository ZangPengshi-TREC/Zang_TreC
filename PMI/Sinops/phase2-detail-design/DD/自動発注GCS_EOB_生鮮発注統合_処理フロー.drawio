          <mxGeometry height="90" width="220" x="210" y="598" as="geometry" />
        </mxCell>
        <mxCell id="p60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Arial;fontSize=12;align=left;spacingLeft=8;" value="&lt;b&gt;STEP60　納品日&lt;/b&gt;&lt;br&gt;yyyymmdd のまま。ShippingDate。" vertex="1">
