  <diagram id="scm-if-layers-cn" name="SCM 统一IF机">
<mxGraphModel dx="1666" dy="875" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="SCM统一IF机（md-data-integration-prod）　2026-09-22" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;fontColor=#222222;" parent="1" vertex="1"><mxGeometry x="40" y="12" width="1200" height="28" as="geometry" /></mxCell><mxCell id="sub" value="去程（实线）：集计SV GCS（大阪） → STS → 【Layer①＝md-data-integration-prod：附带GCS保存集计→Cloud Run处理】→ 【西友连携GCS】反映结果 → 西友DS → Sinops。回程（虚线）：Sinops → DS → 【西友连携GCS】 → Layer① → 自动发注GCS → OrdreSV。启动 TBD。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="1720" height="36" as="geometry" /></mxCell><mxCell id="l1c" value="" style="rounded=1;fillColor=#C45C5C;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="40" y="88" width="14" height="10" as="geometry" /></mxCell><mxCell id="l1" value="Layer① Cloud Run（东京）" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#C45C5C;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="58" y="82" width="180" height="20" as="geometry" /></mxCell><mxCell id="l2c" value="" style="rounded=1;fillColor=#2E79B5;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="250" y="88" width="14" height="10" as="geometry" /></mxCell><mxCell id="l2" value="Layer② Intake · 西友 DS" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#2E79B5;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="268" y="82" width="170" height="20" as="geometry" /></mxCell><mxCell id="l3c" value="" style="rounded=1;fillColor=#1F8A65;strokeColor=none;" parent="1" vertex="1"><mxGeometry x="450" y="88" width="14" height="10" as="geometry" /></mxCell><mxCell id="l3" value="Layer③ 转发 · 西友 DS" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#1F8A65;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="468" y="82" width="160" height="20" as="geometry" /></mxCell><mxCell id="lg" value="实线＝去程　虚线＝回程　灰虚线＝启动" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#888888;" parent="1" vertex="1"><mxGeometry x="640" y="82" width="230" height="20" as="geometry" /></mxCell><mxCell id="orch" value="启动 TBD：Hinemos　或　Cloud Scheduler + Workflows　（DSS②③暂用 Hinemos）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.5;dashed=1;dashPattern=8 6;arcSize=24;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="880" y="74" width="860" height="36" as="geometry" /></mxCell><mxCell id="trialscope" value="TRIAL　　Layer①＝md-data-integration-prod（附带GCS＋Cloud Run一体）　西友连携GCS＝处理结果・公司间唯一通路" style="swimlane;startSize=34;fillColor=#F6F6F6;strokeColor=#333333;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#222222;html=1;whiteSpace=wrap;rounded=1;arcSize=8;" parent="1" vertex="1"><mxGeometry x="40" y="124" width="1720" height="460" as="geometry" /></mxCell><mxCell id="dc" value="数据中心" style="swimlane;startSize=26;fillColor=#FFFFFF;strokeColor=#C8C8C8;fontStyle=1;fontSize=12;fontColor=#333333;html=1;whiteSpace=wrap;rounded=1;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="12" y="44" width="150" height="396" as="geometry" /></mxCell><mxCell id="cs" value="TRMD / CoreSaver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D8D8D8;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="dc" vertex="1"><mxGeometry x="10" y="40" width="130" height="48" as="geometry" /></mxCell><mxCell id="os" value="OrdreSV&lt;br&gt;&lt;font color='#888888'&gt;回程落地&lt;br&gt;自动发注转发经由&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D8D8D8;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="dc" vertex="1"><mxGeometry x="10" y="108" width="130" height="80" as="geometry" /></mxCell><mxCell id="osaka" value="集计SV GCS&lt;br&gt;大阪 asia-northeast2&lt;br&gt;&lt;font color='#C45C5C'&gt;TBL/MAT/DM/TANA&lt;br&gt;_READY + manifest&lt;/font&gt;&lt;br&gt;&lt;font color='#888888'&gt;既有&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#C45C5C;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="178" y="80" width="140" height="140" as="geometry" /></mxCell><mxCell id="sts" value="Storage&lt;br&gt;Transfer&lt;br&gt;&lt;font color='#888888'&gt;差分&lt;br&gt;跨区域&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C45C5C;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#C45C5C;fontStyle=1;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="338" y="105" width="100" height="90" as="geometry" /></mxCell><mxCell id="linkgcs" value="【西友连携 GCS】≠ Layer①&lt;br&gt;asia-northeast1　公司间正本・唯一通路&lt;br&gt;&lt;font color='#666666'&gt;处理结果反映处（合同需核对）&lt;/font&gt;" style="swimlane;startSize=52;fillColor=#E8F7EF;strokeColor=#1F8A65;strokeWidth=2.5;fontStyle=1;fontSize=13;fontColor=#1F8A65;html=1;whiteSpace=wrap;rounded=1;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="920" y="48" width="240" height="250" as="geometry" /></mxCell><mxCell id="land" value="本项目附带 GCS&lt;br&gt;&lt;b&gt;landing&lt;/b&gt;&lt;br&gt;YYYYMMDD&lt;br&gt;&lt;font color='#888888'&gt;集计数据保存&lt;br&gt;TBL/MAT/DM/TANA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1F8A65;fontSize=11;align=center;" parent="pj" vertex="1"><mxGeometry x="16" y="48" width="190" height="180" as="geometry" /></mxCell><mxCell id="out" value="【西友连携GCS】&lt;br&gt;&lt;b&gt;output&lt;/b&gt;&lt;br&gt;YYYYMMDD&lt;br&gt;&lt;font color='#888888'&gt;处理结果&lt;br&gt;_SUCCESS&lt;br&gt;_YYYYMMDDhhmmss&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F8A65;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="linkgcs" vertex="1"><mxGeometry x="16" y="64" width="208" height="160" as="geometry" /></mxCell><mxCell id="pj" value="Layer①　md-data-integration-prod　（附带GCS＋Cloud Run）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#C45C5C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;" parent="trialscope" vertex="1"><mxGeometry x="460" y="48" width="440" height="250" as="geometry" /></mxCell><mxCell id="crj" value="Cloud Run Job&lt;br&gt;&lt;font color='#C45C5C'&gt;4 vCPU / 16 GiB&lt;/font&gt;&lt;br&gt;抽取・共通化・类型转换&lt;br&gt;&lt;font color='#888888'&gt;可用 /tmp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C45C5C;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="pj" vertex="1"><mxGeometry x="220" y="48" width="200" height="180" as="geometry" /></mxCell><mxCell id="auto" value="TRIAL 自动发注　既有 · 与西友连携GCS不同" style="swimlane;startSize=28;fillColor=#FAFAFA;strokeColor=#888888;strokeWidth=1.5;fontStyle=1;fontSize=11;fontColor=#333333;html=1;whiteSpace=wrap;rounded=1;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="1180" y="48" width="520" height="250" as="geometry" /></mxCell><mxCell id="ao-gcs" value="自动发注 GCS&lt;br&gt;&lt;font color='#888888'&gt;回程・发注IF落地&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="auto" vertex="1"><mxGeometry x="16" y="48" width="488" height="72" as="geometry" /></mxCell><mxCell id="ao-xfer" value="既有转发 → OrdreSV&lt;br&gt;&lt;font color='#888888'&gt;非西友DSS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=11;fontColor=#333333;arcSize=8;" parent="auto" vertex="1"><mxGeometry x="16" y="140" width="488" height="72" as="geometry" /></mxCell><mxCell id="note1" value="★ Layer①是一体：本项目附带GCS＋Cloud Run。集计保存在附带GCS，处理后结果反映到西友连携GCS。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#E0C060;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;spacingLeft=10;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="178" y="320" width="982" height="48" as="geometry" /></mxCell><mxCell id="note2" value="回程：西友连携GCS 拉取 → Cloud Run → 自动发注GCS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDDDDD;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;spacingLeft=10;arcSize=8;" parent="trialscope" vertex="1"><mxGeometry x="1180" y="320" width="520" height="48" as="geometry" /></mxCell><mxCell id="e-ao" value="发注IF→自动发注GCS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C45C5C;strokeWidth=2;dashed=1;dashPattern=8 6;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#C45C5C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.15;entryY=1;exitDx=0;exitDy=0;" parent="trialscope" source="crj" target="ao-gcs" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="430" /><mxPoint x="1300" y="430" /></Array></mxGeometry></mxCell><mxCell id="seiyu" value="西友 Azure　　DataSpider（全字段通过。类型转换在 Layer①）" style="swimlane;startSize=34;fillColor=#F3F8F5;strokeColor=#1F8A65;strokeWidth=1.5;fontStyle=1;fontSize=13;fontColor=#1F8A65;html=1;whiteSpace=wrap;rounded=1;arcSize=8;" parent="1" vertex="1"><mxGeometry x="40" y="608" width="1720" height="400" as="geometry" /></mxCell><mxCell id="dss" value="DataSpider　　Layer② Intake　/　Layer③ 转发" style="swimlane;startSize=28;fillColor=#F7FAFC;strokeColor=#2E79B5;strokeWidth=1;dashed=1;dashPattern=8 6;fontStyle=1;fontSize=12;fontColor=#2E79B5;html=1;whiteSpace=wrap;rounded=1;arcSize=8;" parent="seiyu" vertex="1"><mxGeometry x="16" y="48" width="1688" height="140" as="geometry" /></mxCell><mxCell id="ds2" value="Layer②　Intake&lt;br&gt;&lt;font color='#2E79B5'&gt;【西友连携GCS】→ DWH　仅主数据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E79B5;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;fontColor=#2E79B5;fontStyle=1;arcSize=8;" parent="dss" vertex="1"><mxGeometry x="16" y="40" width="820" height="80" as="geometry" /></mxCell><mxCell id="ds3" value="Layer③　转发&lt;br&gt;&lt;font color='#1F8A65'&gt;去程→Sinops　回程→【西友连携GCS】&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F8A65;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F8A65;fontStyle=1;arcSize=8;" parent="dss" vertex="1"><mxGeometry x="852" y="40" width="820" height="80" as="geometry" /></mxCell><mxCell id="dwh" value="Datalake / DWH&lt;br&gt;&lt;font color='#2E79B5'&gt;Layer② 落地&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E79B5;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;arcSize=8;" parent="seiyu" vertex="1"><mxGeometry x="16" y="208" width="820" height="152" as="geometry" /></mxCell><mxCell id="mdscm" value="MDSCM / Sinops&lt;br&gt;&lt;font color='#1F8A65'&gt;Layer③ 落地&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F8A65;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;arcSize=8;" parent="seiyu" vertex="1"><mxGeometry x="852" y="208" width="400" height="152" as="geometry" /></mxCell><mxCell id="bo" value="BO 系&lt;br&gt;&lt;font color='#7B64B8'&gt;本阶段非程序范围&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B64B8;strokeWidth=1.5;align=center;verticalAlign=middle;fontSize=12;fontColor=#333333;arcSize=8;" parent="seiyu" vertex="1"><mxGeometry x="1272" y="208" width="400" height="152" as="geometry" /></mxCell><m