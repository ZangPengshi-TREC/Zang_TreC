        <mxCell id="lg0" value="TRIAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="596" y="34" width="136" height="26" as="geometry"/></mxCell>
        <mxCell id="lg1" value="GCP（今回申請）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="746" y="34" width="136" height="26" as="geometry"/></mxCell>
        <mxCell id="lg2" value="西友 DataSpider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="896" y="34" width="136" height="26" as="geometry"/></mxCell>
