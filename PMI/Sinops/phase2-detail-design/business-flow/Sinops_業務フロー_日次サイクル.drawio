        <mxCell id="s1" value="&lt;b&gt;1　TRIAL 基幹&lt;/b&gt;&lt;br&gt;・マスタ 01–05・13・14&lt;br&gt;・実績・在庫 06–12・15&lt;br&gt;・倉庫系 16–21" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2　GCP（今回申請）&lt;/b&gt;&lt;br&gt;・抽出&lt;br&gt;・型・コード変換&lt;br&gt;・連携GCSへ配置" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="364" y="120" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3　西友 DataSpider&lt;/b&gt;&lt;br&gt;・マスタ: Intake 洗替&lt;br&gt;・実績: 転送のみ&lt;br&gt;・全フィールド通過" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="668" y="120" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;4　Sinops&lt;/b&gt;&lt;br&gt;・データ受信&lt;br&gt;・発注勧告を計算" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="972" y="120" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5　Sinops&lt;/b&gt;&lt;br&gt;・24 勧告当日分（通常）&lt;br&gt;・25 翌日以降分（代替）&lt;br&gt;・22・23 倉庫勧告" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="972" y="316" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6　西友 DataSpider&lt;/b&gt;&lt;br&gt;・勧告を転送&lt;br&gt;・連携GCSへ配置" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="972" y="512" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;7　GCP（今回申請）&lt;/b&gt;&lt;br&gt;・勧告を取得&lt;br&gt;・勧告→発注統合変換&lt;br&gt;・生鮮増分・新規" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="668" y="512" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;8　TRIAL 自動発注&lt;/b&gt;&lt;br&gt;・自動発注GCS&lt;br&gt;・OrdreSV 自動確定&lt;br&gt;・CoreSaver 同期" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="364" y="512" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b&gt;9　TRIAL 各業務&lt;/b&gt;&lt;br&gt;・発注・物流・納品&lt;br&gt;・入荷予定 12 を生成&lt;br&gt;・入荷実績 11 を生成" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="512" width="224" height="124" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;日次サイクル&lt;/b&gt;&lt;br&gt;往路 1 → 4（データ送信）&lt;br&gt;復路 5 → 8（自動確定）&lt;br&gt;入荷 9 → 1（次サイクルへ）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;strokeWidth=2;strokeColor=#666666;fillColor=none;fontSize=14;" vertex="1" parent="1"><mxGeometry x="364" y="316" width="528" height="124" as="geometry"/></mxCell>
        <mxCell id="e1" value="マスタ・実績" style="endArrow=block;endFill=1;html=1;strokeWidth=3;strokeColor=#1A202C;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
