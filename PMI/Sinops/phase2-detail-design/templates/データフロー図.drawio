        <mxCell id="l_j3z" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;align=right;" value="&lt;b&gt;&lt;span style=&quot;font-size:13px;color:#FF0000&quot;&gt;j3z：DWH 保存の追加が必要（西友側）&lt;/span&gt;&lt;/b&gt;" vertex="1">
